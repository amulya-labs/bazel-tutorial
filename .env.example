# Economic Dashboard Configuration
# Copy this file to .env and fill in your values

# FRED API Key (required for data fetching)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Database path (optional, default: ./data/econ.db)
# ECON_DB_PATH=./data/econ.db

# API server port (optional, default: 8000)
# PORT=8000

"""MODULE.bazel defines the root module and its dependencies using Bzlmod.

Bzlmod is the new standard for managing external dependencies in Bazel.
It replaces the legacy WORKSPACE system with a more maintainable approach.
"""

module(
    name = "bazel_multilang_tutorial",
    version = "1.0.0",
)

################################################################################
# Python Rules - For building Python applications and tests
################################################################################

# Register the rules_python extension
bazel_dep(name = "rules_python", version = "0.31.0")

# Configure Python toolchain (Python 3.11)
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)

# Configure pip dependencies from requirements.txt
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip_deps",
    python_version = "3.11",
    requirements_lock = "//py_service:requirements.txt",
)
use_repo(pip, "pip_deps")

################################################################################
# Go Rules - For building Go applications and tests
################################################################################

# Register the rules_go extension
bazel_dep(name = "rules_go", version = "0.46.0")
bazel_dep(name = "gazelle", version = "0.35.0")

# Configure Go toolchain
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.21.5")
